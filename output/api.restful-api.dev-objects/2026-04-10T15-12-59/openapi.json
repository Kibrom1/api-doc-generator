{
  "openapi": "3.1.0",
  "info": {
    "title": "Restful API Dev - Objects API",
    "description": "A simple RESTful API for managing objects (consumer electronics/devices). Each object has an id, a name, and a flexible `data` field containing arbitrary key-value metadata about the object. This API is publicly accessible and requires no authentication.\n",
    "version": "1.0.0",
    "contact": {
      "url": "https://api.restful-api.dev"
    }
  },
  "servers": [
    {
      "url": "https://api.restful-api.dev",
      "description": "Production server"
    }
  ],
  "paths": {
    "/objects": {
      "get": {
        "operationId": "listObjects",
        "summary": "List all objects",
        "description": "Returns a list of all objects stored in the system. Each object contains an `id`, a `name`, and an optional `data` field which is a flexible object containing additional metadata. The `data` field structure varies per object and may include properties such as color, capacity, price, generation, year, CPU model, screen size, and more. The `data` field may also be `null`.\n",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Filter objects by one or more IDs. Can be specified multiple times (e.g., ?id=1&id=2) to retrieve a subset of objects.\n",
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "style": "form",
            "explode": true
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of object resources.",
            "headers": {
              "Content-Type": {
                "schema": {
                  "type": "string",
                  "example": "application/json;charset=UTF-8"
                }
              },
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "example": "no-cache, no-store, max-age=0, must-revalidate"
                }
              },
              "X-Content-Type-Options": {
                "schema": {
                  "type": "string",
                  "example": "nosniff"
                }
              },
              "X-XSS-Protection": {
                "schema": {
                  "type": "string",
                  "example": "1; mode=block"
                }
              },
              "X-Frame-Options": {
                "schema": {
                  "type": "string",
                  "example": "DENY"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Object"
                  }
                },
                "examples": {
                  "fullList": {
                    "summary": "Full list of objects",
                    "value": [
                      {
                        "id": "1",
                        "name": "Google Pixel 6 Pro",
                        "data": {
                          "color": "Cloudy White",
                          "capacity": "128 GB"
                        }
                      },
                      {
                        "id": "2",
                        "name": "Apple iPhone 12 Mini, 256GB, Blue",
                        "data": null
                      },
                      {
                        "id": "3",
                        "name": "Apple iPhone 12 Pro Max",
                        "data": {
                          "color": "Cloudy White",
                          "capacity GB": 512
                        }
                      },
                      {
                        "id": "7",
                        "name": "Apple MacBook Pro 16",
                        "data": {
                          "year": 2019,
                          "price": 1849.99,
                          "CPU model": "Intel Core i9",
                          "Hard disk size": "1 TB"
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 invalid query parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found \u2014 no objects matched the given criteria.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createObject",
        "summary": "Create a new object",
        "description": "Creates a new object with a `name` and an optional `data` payload. The server assigns a unique `id` to the created object and returns the full object representation including the assigned `id` and a `createdAt` timestamp.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObjectInput"
              },
              "examples": {
                "newDevice": {
                  "summary": "Create a new device object",
                  "value": {
                    "name": "Apple iPhone 15 Pro",
                    "data": {
                      "color": "Natural Titanium",
                      "capacity": "256 GB",
                      "price": 999.99
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The newly created object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectCreated"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 malformed JSON or missing required fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/objects/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "The unique string identifier of the object.",
          "schema": {
            "type": "string",
            "example": "7"
          }
        }
      ],
      "get": {
        "operationId": "getObjectById",
        "summary": "Retrieve a single object by ID",
        "description": "Returns the full representation of a single object identified by its unique `id`. The `data` field structure varies per object.\n",
        "responses": {
          "200": {
            "description": "A single object resource.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Object"
                },
                "examples": {
                  "macbookPro": {
                    "summary": "Apple MacBook Pro 16",
                    "value": {
                      "id": "7",
                      "name": "Apple MacBook Pro 16",
                      "data": {
                        "year": 2019,
                        "price": 1849.99,
                        "CPU model": "Intel Core i9",
                        "Hard disk size": "1 TB"
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found \u2014 no object with the specified ID exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notFound": {
                    "summary": "Object not found",
                    "value": {
                      "error": "Oject with id=99 was not found."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceObject",
        "summary": "Replace an object (full update)",
        "description": "Fully replaces an existing object identified by `id`. The entire object (name and data) must be provided. Returns the updated object with an `updatedAt` timestamp.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObjectInput"
              },
              "examples": {
                "replaceDevice": {
                  "summary": "Replace a device object",
                  "value": {
                    "name": "Apple iPhone 15 Pro Max",
                    "data": {
                      "color": "Black Titanium",
                      "capacity": "512 GB",
                      "price": 1199.99
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The fully updated object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectUpdated"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 malformed JSON or missing required fields.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found \u2014 no object with the specified ID exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateObject",
        "summary": "Partially update an object",
        "description": "Partially updates an existing object identified by `id`. Only the provided fields are updated. Returns the updated object with an `updatedAt` timestamp.\n",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ObjectPatch"
              },
              "examples": {
                "patchName": {
                  "summary": "Update only the name",
                  "value": {
                    "name": "Apple iPhone 15 Pro (Updated)"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The partially updated object.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ObjectUpdated"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request \u2014 malformed JSON.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not Found \u2014 no object with the specified ID exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deleteObject",
        "summary": "Delete an object",
        "description": "Deletes the object identified by `id`. Returns a confirmation message upon successful deletion.\n",
        "responses": {
          "200": {
            "description": "Confirmation of deletion.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteConfirmation"
                },
                "examples": {
                  "deleted": {
                    "summary": "Successful deletion",
                    "value": {
                      "message": "Object with id = 7 has been deleted."
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found \u2014 no object with the specified ID exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "notFound": {
                    "summary": "Object not found",
                    "value": {
                      "error": "Oject with id=99 was not found."
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ObjectData": {
        "type": "object",
        "nullable": true,
        "description": "A flexible, schema-less object containing metadata about the device. Keys and value types vary per object. Common keys observed include color, capacity, price, generation, year, CPU model, Hard disk size, Screen size, Strap Colour, Case Size, and Description. All keys and values are arbitrary.\n",
        "additionalProperties": true,
        "example": {
          "color": "Cloudy White",
          "capacity": "128 GB",
          "price": 389.99,
          "year": 2019,
          "CPU model": "Intel Core i9",
          "Hard disk size": "1 TB"
        }
      },
      "Object": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The unique identifier for the object, assigned by the server.",
            "example": "7"
          },
          "name": {
            "type": "string",
            "description": "The display name of the object.",
            "minLength": 1,
            "example": "Apple MacBook Pro 16"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ObjectData"
              },
              {
                "type": "null"
              }
            ],
            "description": "Flexible metadata object for the item. May be null if no additional data is available.\n"
          }
        }
      },
      "ObjectInput": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "The display name of the object.",
            "minLength": 1,
            "example": "Apple iPhone 15 Pro"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ObjectData"
              },
              {
                "type": "null"
              }
            ],
            "description": "Optional flexible metadata object. May be omitted or set to null.\n"
          }
        }
      },
      "ObjectPatch": {
        "type": "object",
        "description": "Partial update payload. At least one field should be provided.\n",
        "properties": {
          "name": {
            "type": "string",
            "description": "The new display name of the object.",
            "minLength": 1,
            "example": "Apple iPhone 15 Pro (Updated)"
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ObjectData"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated metadata object."
          }
        }
      },
      "ObjectCreated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Object"
          },
          {
            "type": "object",
            "properties": {
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of when the object was created.",
                "example": "2026-04-10T15:11:38.000Z"
              }
            }
          }
        ]
      },
      "ObjectUpdated": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Object"
          },
          {
            "type": "object",
            "properties": {
              "updatedAt": {
                "type": "string",
                "format": "date-time",
                "description": "ISO 8601 timestamp of when the object was last updated.",
                "example": "2026-04-10T15:11:38.000Z"
              }
            }
          }
        ]
      },
      "DeleteConfirmation": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "description": "Confirmation message indicating the object was deleted.",
            "example": "Object with id = 7 has been deleted."
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "A human-readable error message.",
            "example": "Oject with id=99 was not found."
          }
        }
      }
    }
  }
}